{
  "version": "2.0",
  "extensions": {
    "http": {
      "maxRequestBodySize": 104857600 // 100 MB in bytes
    }
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  }
}
