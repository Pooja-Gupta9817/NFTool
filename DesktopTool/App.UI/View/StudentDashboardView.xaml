<UserControl x:Class="DesktopTool.App.UI.View.StudentDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="Auto" Width="Auto">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="📊 Dashboard Overview"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,5"/>

        <!-- Main Content Grid -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Uploaded Files Card -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="3">
                <StackPanel Margin="10">
                    <TextBlock Text="📁 Files" Style="{StaticResource CardHeaderText}" FontSize="14"/>
                    <TextBlock Text="{Binding TotalFiles}" FontSize="28" FontWeight="Bold" Margin="0,5,0,2"/>
                    <TextBlock Text="Total PDFs" Style="{StaticResource CardSubText}" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Recent Files Card -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="3">
                <StackPanel Margin="10">
                    <TextBlock Text="📄 Recent Files" Style="{StaticResource CardHeaderText}" FontSize="14"/>
                    <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0">
                        <ItemsControl ItemsSource="{Binding RecentFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="10" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- AI Feedback Card -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="3">
                <StackPanel Margin="10">
                    <TextBlock Text="🤖 AI Feedback" Style="{StaticResource CardHeaderText}" FontSize="14"/>
                    <TextBlock Text="{Binding AIFeedbackSummary}" 
                               TextWrapping="Wrap" 
                               Style="{StaticResource CardSubText}"
                               FontSize="11"
                               MaxHeight="70"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Study Plan Card -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="3">
                <StackPanel Margin="10">
                    <TextBlock Text="📅 Study Plan" Style="{StaticResource CardHeaderText}" FontSize="14"/>
                    <TextBlock Text="{Binding StudyPlanSummary}" 
                               TextWrapping="Wrap" 
                               Style="{StaticResource CardSubText}"
                               FontSize="11"
                               MaxHeight="70"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- AI Assistant Chat - Takes up right side -->
            <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Grid.RowSpan="2" Style="{StaticResource CardStyle}" Margin="3">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Text="💬 Ask AI" Style="{StaticResource CardHeaderText}" Grid.Row="0" FontSize="14"/>

                    <!-- Chat Area -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,8,0,8"
                                  Padding="5"
                                  Background="#F8F8F8"
                                  BorderBrush="#E0E0E0"
                                  BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding ChatHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                               TextWrapping="Wrap" 
                                               Margin="5,3" 
                                               FontSize="11"
                                               LineHeight="14"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Chat Input -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                                 Height="25"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,8,0"
                                 FontSize="11"/>

                        <Button Grid.Column="1"
                                Content="Send"
                                Command="{Binding AskCommand}"
                                Width="50"
                                Height="25"
                                Background="#C8B07E"
                                Foreground="Black"
                                FontWeight="SemiBold"
                                FontSize="11"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>