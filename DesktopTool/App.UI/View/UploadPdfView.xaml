<UserControl x:Class="DesktopTool.App.UI.View.UploadPdfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DesktopTool.App.UI.View"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <local:NullToBoolConverter x:Key="NullToBoolConverter" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Border Background="{DynamicResource ControlBackgroundBrush}" Padding="20" Margin="40"
                CornerRadius="10" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Upload PDF File" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Margin="0 0 0 20" 
                           Foreground="{DynamicResource ForegroundBrush}"/>

                <!-- Select File Button -->
                <Button Command="{Binding SelectFileCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/openFile.png" Width="16" Height="16" Margin="0,0,5,0"/>
                        <TextBlock Text="Select PDF File"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="{Binding FileName}" 
                           FontStyle="Italic" 
                           Foreground="{DynamicResource ForegroundBrush}" 
                           Margin="0 5 0 10"/>

                <!-- Upload Button -->
                <Button Command="{Binding UploadCommand}"
                        IsEnabled="{Binding SelectedFilePath, Converter={StaticResource NullToBoolConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/upload.png" Width="16" Height="16" Margin="0,0,5,0"/>
                        <TextBlock Text="Upload PDF"/>
                    </StackPanel>
                </Button>

                <!-- Progress -->
                <TextBlock Text="{Binding UploadProgress, StringFormat=Progress: {0}%}" 
                           Margin="0 15 0 5" 
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <ProgressBar Value="{Binding UploadProgress}" 
                             Height="20" 
                             Maximum="100"
                             Foreground="{DynamicResource AccentBrush}" 
                             Background="{DynamicResource ControlBackgroundBrush}"/>

                <!-- Success Message -->
                <TextBlock x:Name="SuccessMessage"
                           Text="✅ Upload Successful"
                           Foreground="Green"
                           FontWeight="Bold"
                           Opacity="0"
                           Margin="0 10 0 0"
                           HorizontalAlignment="Center"/>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorMessage"
                           Text="❌ Upload Failed"
                           Foreground="Red"
                           FontWeight="Bold"
                           Opacity="0"
                           Margin="0 10 0 0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
