<Window x:Class="DesktopTool.App.UI.View.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopTool.App.UI.View"
        Title="Login / Register" Height="500" Width="800" >

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Window.Resources>

    <Grid Margin="40">
        <Border Background="#FFF" CornerRadius="10" Padding="20" BorderBrush="#DDD" BorderThickness="1" >
            <StackPanel>

                <TextBlock Text="Welcome" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton Content="Login"
                             GroupName="Mode"
                             IsChecked="{Binding IsLoginMode}" />

                    <RadioButton Content="Register"
                             GroupName="Mode"
                             IsChecked="{Binding IsLoginMode, Converter={StaticResource InverseBoolConverter}}"
                             Margin="20,0,0,0" />
                </StackPanel>

                <!-- Name field (Register mode only) -->
                <TextBlock Text="Name"
                       Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBox Text="{Binding Name}" 
                     Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Text="Email" Margin="0,10,0,0" />
                <TextBox Text="{Binding Email}" />

                <TextBlock Text="Password" Margin="0,10,0,0"/>
                <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" />

                <!-- Role Selection (Register mode only) -->
                <StackPanel Orientation="Horizontal"
                        Margin="0,10,0,0"
                        Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Role:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton Content="Student"
                             GroupName="Role"
                             IsChecked="{Binding IsTeacher, Converter={StaticResource InverseBoolConverter}}" />
                    <RadioButton Content="Teacher"
                             GroupName="Role"
                             IsChecked="{Binding IsTeacher}"
                             Margin="10,0,0,0"/>
                </StackPanel>

                <Button Content="{Binding ActionButtonText}"
                    Command="{Binding SubmitCommand}"
                    Margin="0,20,0,0"
                    Height="40"
                    Background="#007ACC"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderBrush="Transparent"
                    Cursor="Hand"/>

                <TextBlock Text="{Binding ErrorMessage}"
           Foreground="Red"
           FontWeight="Bold"
           Margin="0,10,0,0"
           TextWrapping="Wrap"/>

            </StackPanel>
        </Border>
    </Grid>

</Window>
