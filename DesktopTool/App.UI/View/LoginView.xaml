<Window x:Class="DesktopTool.App.UI.View.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopTool.App.UI.View"
        Title="Login / Register" Height="500" Width="800" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Window.Resources>

    <Grid Margin="40">
        <Border Background="{DynamicResource ControlBackgroundBrush}" 
                CornerRadius="10" 
                Padding="20" 
                BorderBrush="{DynamicResource ControlBorderBrush}" 
                BorderThickness="1">
            <StackPanel>

                <TextBlock Text="Welcome" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Margin="0,0,0,20" 
                           Foreground="{DynamicResource ForegroundBrush}"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton Content="Login"
                                 GroupName="Mode"
                                 IsChecked="{Binding IsLoginMode}" 
                                 Foreground="{DynamicResource ForegroundBrush}"/>

                    <RadioButton Content="Register"
                                 GroupName="Mode"
                                 IsChecked="{Binding IsLoginMode, Converter={StaticResource InverseBoolConverter}}"
                                 Margin="20,0,0,0"
                                 Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>

                <TextBlock Text="Name" 
                           Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibilityConverter}}"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBox Text="{Binding Name}"
                         Background="{DynamicResource ControlBackgroundBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"
                         Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <TextBlock Text="Email" 
                           Margin="0,10,0,0" 
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBox Text="{Binding Email}"
                         Background="{DynamicResource ControlBackgroundBrush}"
                         Foreground="{DynamicResource ForegroundBrush}"/>

                <TextBlock Text="Password" 
                           Margin="0,10,0,0" 
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <PasswordBox x:Name="PasswordBox" 
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Role:" VerticalAlignment="Center" Margin="0,0,10,0" 
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <RadioButton Content="Student"
                                 GroupName="Role"
                                 IsChecked="{Binding IsTeacher, Converter={StaticResource InverseBoolConverter}}"
                                 Foreground="{DynamicResource ForegroundBrush}"/>
                    <RadioButton Content="Teacher"
                                 GroupName="Role"
                                 IsChecked="{Binding IsTeacher}"
                                 Margin="10,0,0,0"
                                 Foreground="{DynamicResource ForegroundBrush}"/>
                </StackPanel>

                <Button Content="{Binding ActionButtonText}"
                        Command="{Binding SubmitCommand}"
                        Margin="0,20,0,0"
                        Height="40"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        FontWeight="Bold"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        Cursor="Hand"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           FontWeight="Bold"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"/>

                <Button Content="🌙"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        FontSize="16"
                        Background="Transparent"
                        Foreground="{DynamicResource ForegroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        Width="40" Height="30"
                        Margin="10,70,0,0"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip="Toggle Theme"/>

            </StackPanel>
        </Border>

        <Grid>
            <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                  Background="{DynamicResource BackgroundBrush}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Panel.ZIndex="999">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="150" Height="20" />
                    <TextBlock Text="Please wait..." Foreground="{DynamicResource ForegroundBrush}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
