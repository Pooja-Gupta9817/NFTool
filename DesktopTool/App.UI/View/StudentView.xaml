<UserControl x:Class="DesktopTool.App.UI.View.StudentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DesktopTool.App.UI.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>
        <!-- Sidebar -->
        <StackPanel Background="DarkSlateBlue" Width="180" DockPanel.Dock="Left">
            <TextBlock Text="Student Panel" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0 10"/>
            <Button Content="📊 Dashboard" Command="{Binding OpenDashboardCommand}"  Style="{StaticResource SidebarButtonStyle}" />
            <Button Content="📁 My Files" Command="{Binding OpenMyFilesCommand}" Style="{StaticResource SidebarButtonStyle}" />
            <Button Content="📈 My Stats" Command="{Binding OpenMyStatsCommand}" Style="{StaticResource SidebarButtonStyle}" />
            <Button Content="🧠 Study Plan" Command="{Binding OpenStudyPlanCommand}" Style="{StaticResource SidebarButtonStyle}" />
            <Button Content="🤖 AI Assistant" Command="{Binding OpenAIAssistantCommand}" Style="{StaticResource SidebarButtonStyle}" />

        </StackPanel>

        <!-- TopBar -->
        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource ControlBackgroundBrush}" Height="50" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                <TextBlock Text="Name: " FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="{Binding LoggedInUserName}" Margin="5,0" Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Email: " FontWeight="Bold" Margin="20,0,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="{Binding LoggedInUserEmail}" Margin="5,0" Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>

            <Button Content="🚪 Logout"
                  Width="80"
                  Height="30"
                  Margin="10,0,10,0"
                  VerticalAlignment="Center"
                  Command="{Binding LogoutCommand}"
                  Background="{DynamicResource AccentBrush}"
                  Foreground="{DynamicResource ForegroundBrush}" />
        </DockPanel>

        <!-- Main Content -->
        <ContentControl Content="{Binding CurrentViewModel}" DockPanel.Dock="Right" Background="{DynamicResource BackgroundBrush}"/>
    </DockPanel>
</UserControl>
