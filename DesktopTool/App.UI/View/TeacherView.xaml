<UserControl x:Class="DesktopTool.App.UI.View.TeacherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DesktopTool.App.UI.ViewModel"
             xmlns:local="clr-namespace:DesktopTool.App.UI.View"
             Height="Auto" Width="Auto">

    <DockPanel>
        <!-- Sidebar -->
        <StackPanel Background="Navy" Width="180" DockPanel.Dock="Left">
            <TextBlock Text="Teacher Panel" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0 10"/>
            <Button Content="📄 Upload PDF" Command="{Binding OpenUploadPdfCommand}"  />
            <Button Content="📊 Upload Marks" Command="{Binding OpenUploadMarksCommand}"  />
            <Button Content="👥 View Students" Command="{Binding OpenStudentListCommand}" />
        </StackPanel>

        <!-- Top Info and Theme -->
        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource ControlBackgroundBrush}" Height="50" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                <TextBlock Text="Name: " FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="{Binding LoggedInUserName}" Margin="5,0" Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Email: " FontWeight="Bold" Margin="20,0,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="{Binding LoggedInUserEmail}" Margin="5,0" Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>

            <Button Content="🚪 Logout"
        Width="80"
        Height="30"
        Margin="10,0,10,0"
        VerticalAlignment="Center"
        Command="{Binding LogoutCommand}"
        Background="{DynamicResource AccentBrush}"
        Foreground="{DynamicResource ForegroundBrush}" />


        </DockPanel>

        <!-- Content -->
        <ContentControl Content="{Binding CurrentViewModel}" DockPanel.Dock="Right" Background="{DynamicResource BackgroundBrush}"/>
    </DockPanel>
</UserControl>
