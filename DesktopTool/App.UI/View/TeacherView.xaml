<UserControl x:Class="DesktopTool.App.UI.View.TeacherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DesktopTool.App.UI.ViewModel"
             xmlns:local="clr-namespace:DesktopTool.App.UI.View"
             Height="Auto" Width="Auto">

    <DockPanel>
        <!-- Sidebar -->
        <StackPanel Background="{DynamicResource ApplicationThemeBrush}" Width="180" DockPanel.Dock="Left">
            <TextBlock Text="Teacher Panel" Foreground="{DynamicResource ForegroundBrush}" FontWeight="Bold" FontSize="16" Margin="0 10"/>
            <Button Content="📄 Upload PDF" Command="{Binding OpenUploadPdfCommand}" Style="{StaticResource NavButton}" />
            <Button Content="📊 Upload Marks" Command="{Binding OpenUploadMarksCommand}" Style="{StaticResource NavButton}" />
            <Button Content="👥 View Students" Command="{Binding OpenStudentListCommand}" Style="{StaticResource NavButton}" />
        </StackPanel>

        <!-- Top Info and Theme -->
        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource ControlBackgroundBrush}" Height="50">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                <TextBlock Text="Name: " FontWeight="Bold" Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="{Binding LoggedInUserName}" Margin="5,0" Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="Email: " FontWeight="Bold" Margin="20,0,0,0" Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="{Binding LoggedInUserEmail}" Margin="5,0" Foreground="{DynamicResource ForegroundBrush}"/>
            </StackPanel>
            <Button Content="🌙/☀"
                    Command="{Binding ToggleThemeCommand}"
                    Background="Transparent"
                    Foreground="{DynamicResource ForegroundBrush}"
                    Width="40" Height="30" Margin="10" HorizontalAlignment="Right"/>
        </DockPanel>

        <!-- Content -->
        <ContentControl Content="{Binding CurrentViewModel}" DockPanel.Dock="Right" Background="{DynamicResource BackgroundBrush}"/>
    </DockPanel>
</UserControl>
