<UserControl x:Class="DesktopTool.App.UI.View.TeacherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DesktopTool.App.UI.ViewModel"
             xmlns:local="clr-namespace:DesktopTool.App.UI.View"
             Height="Auto" Width="Auto">
   

    <DockPanel>
        <!-- Sidebar -->
        <StackPanel Background="#2B2D42" Width="180" DockPanel.Dock="Left">
            <TextBlock Text="Teacher Panel" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0 10"/>
            <Button Content="📄 Upload PDF" Command="{Binding OpenUploadPdfCommand}" Style="{StaticResource NavButton}" />
            <Button Content="📊 Upload Marks" Command="{Binding OpenUploadMarksCommand}" Style="{StaticResource NavButton}" />
            <Button Content="👥 View Students" Command="{Binding OpenStudentListCommand}" Style="{StaticResource NavButton}" />
        </StackPanel>

        <!-- Content -->
        <ContentControl Content="{Binding CurrentViewModel}" DockPanel.Dock="Right" />
    </DockPanel>
</UserControl>
